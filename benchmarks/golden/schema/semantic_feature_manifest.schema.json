{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "minimalizer://golden-comparison/semantic-feature-manifest.schema.json",
  "title": "Minimalizer Semantic Feature Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "features", "relations", "evaluation_regions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "evaluation_regions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evaluationRegion"}
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semantic_role", "disposition", "importance", "palette_role"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "semantic_role": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["required", "optional", "forbidden"]},
        "importance": {"enum": ["identity_critical", "important", "supporting", "compressible"]},
        "palette_role": {"enum": ["primary", "secondary", "accent", "contrast", "neutral", "not_applicable"]},
        "compression_policy": {"enum": ["preserve", "symbolic", "omit"]}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"enum": ["part_of", "attached_to", "overlaps", "paired_with", "contrasts_with"]},
        "object": {"type": "string", "minLength": 1}
      }
    },
    "evaluationRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "feature_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "feature_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
